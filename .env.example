# Ganaterm配置文件
# 将此文件复制到~/.config/ganaterm/.env并填写您的API密钥

# API密钥配置
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_api_key_here

# 模型配置
MODEL_PRIORITIES=["openai", "deepseek", "xai"]
MODEL_MAP={"openai": "gpt-4o", "deepseek": "deepseek-chat", "xai": "grok-3"}

# UI配置
USE_MARKDOWN=true
USE_TYPEWRITER=true
TYPEWRITER_SPEED=256

# 记忆配置
MEMORY_IMPORTANCE_THRESHOLD=0.3
MAX_SHORT_TERM_MEMORY=20
MAX_MID_TERM_MEMORY=50
MAX_LONG_TERM_MEMORY=100

# 网络配置
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890 